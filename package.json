{
  "name": "flight-shield",
  "version": "3.0.0",
  "description": "Zero-dependency toolkit to prevent thundering herds, cache stampedes, and redundant API calls — SingleFlight, StampedeShield, and BatchFlight for Node.js.",
  "keywords": [
    "singleflight",
    "thundering-herd",
    "cache-stampede",
    "batching",
    "dataloader",
    "deduplication",
    "coalescing",
    "request-coalescing",
    "concurrency",
    "backend",
    "performance"
  ],
  "homepage": "https://github.com/mayankcodes-dev/flight-shield#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayankcodes-dev/flight-shield.git"
  },
  "bugs": {
    "url": "https://github.com/mayankcodes-dev/flight-shield/issues"
  },
  "author": "Mayank",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "require": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "bench": "npm run build && node benchmarks/coalesce.bench.mjs",
    "check:exports": "npx publint --pack false",
    "check:types": "node scripts/check-exports.mjs",
    "prepublishOnly": "npm run build && npm run test && npm run check:exports"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "mitata": "^1.0.34",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
